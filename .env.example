# Вариант 1: Готовый Authorization Key (Base64 от Client ID:Client Secret)
GIGACHAT_CREDENTIALS="YOUR_GIGACHAT_AUTH_KEY"

# Вариант 2: Или укажите пару Client ID и Client Secret (будут закодированы в Base64 автоматически)
GIGACHAT_CLIENT_ID="YOUR_CLIENT_ID"
GIGACHAT_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# Scope и модель GigaChat API (GigaChat-Pro, GigaChat-Max или GigaChat)
GIGACHAT_SCOPE="GIGACHAT_API_PERS"
GIGACHAT_MODEL="GigaChat-Pro"

# Optional: path to the Python interpreter used for OCR.
# By default the server tries python, py -3 (Windows), or python3.
# PYTHON_EXECUTABLE="C:\path\to\python.exe"

# Переменные окружения платформы
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
